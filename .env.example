# Copy this file to .env and fill in real values locally.
# Never commit the real .env file — it's excluded via .gitignore.

# Used by netlify/functions/aria-chat.js
GROK_API_KEY=

# Used by netlify/functions/aria-chat-groq.js
GROQ_API_KEY=

# Used by netlify/functions/avi-courier-quote.js (AVI Courier shipping API)
AVI_API_KEY=

# Used by netlify/functions/apify-scrape-start.js (Apify retailer scrapers)
APIFY_API_KEY=

# Shared secret the scheduled Ofertas refresher presents as a bearer token
# (scripts/refresh-sales-cache.js, run by
# .github/workflows/refresh-sales-cache.yml). Set the SAME value as the
# SALES_REFRESH_TOKEN repository secret on GitHub. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SALES_REFRESH_TOKEN=
