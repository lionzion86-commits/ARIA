# Copy this file to .env and fill in real values locally.
# Never commit the real .env file — it's excluded via .gitignore.

# Used by netlify/functions/aria-chat.js
GROK_API_KEY=

# Used by netlify/functions/aria-chat-groq.js
GROQ_API_KEY=

# Used by netlify/functions/avi-courier-quote.js (AVI Courier shipping API)
AVI_API_KEY=

# Used by netlify/functions/apify-scrape.js (Apify retailer scrapers)
APIFY_API_KEY=
