/checkout.html
  Cache-Control: no-cache, no-store, must-revalidate
# index.html must always revalidate: a phone holding a cached copy of an
# older index.html keeps running that copy's cart code. Before PR #89 that
# code doubled every cart line on every page load (1 -> 2 -> ... -> 256),
# and a stale copy would keep re-corrupting carts after the fix shipped.
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache


# Catalogue and feed JSONs change when the catalogues are re-pulled
# (days, not minutes). An hour fresh plus a day of
# stale-while-revalidate ends the revalidate-every-visit pattern
# without ever serving week-old stock.
/*.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Unfingerprinted root scripts and static images get the same
# treatment, on a bounded leash.
/*.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.jpeg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Visual-search index (2026-10-15): shards and the CLIP model are
# versioned through visual-index/manifest.json and refreshed with
# catalog pulls; a day of cache keeps photo queries off the network
# path while letting a refreshed index land within a day.
/visual-index/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# THE HOMEPAGE'S OWN DATA REVALIDATES (#443, 2026-10-29). Danny's
# iPhone showed an earlier build's pills and shelves for hours: these
# files change with every build, not with every catalogue pull. no-cache
# still caches -- the phone asks, the CDN answers 304 when nothing
# changed. The bundle also fetches them with its own hash (dataUrl).
/assets/home/*
  Cache-Control: no-cache
/assets/ofertas/*
  Cache-Control: no-cache
/ofertas-feed-lite.json
  Cache-Control: no-cache
/ofertas-feed.json
  Cache-Control: no-cache
/vs-deals.json
  Cache-Control: no-cache

# PERF (2026-10-14, Issue #388): fingerprinted app bundle. This rule
# is LAST on purpose: in _headers the last matching rule wins, and
# the bundle also matches /*.js above. The filename
# carries a content hash, so a year of immutable caching can never
# strand a shopper on stale code. index.html itself stays no-cache
# above -- it is the only door to the current bundle name.
/build/*
  Cache-Control: public, max-age=31536000, immutable
