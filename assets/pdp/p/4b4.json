alanca. Al activarse, la cápsula gira hasta 7,000 revoluciones por minuto, mezclando el café molido con el agua y produciendo la crema perfecta para disfrutar de un café de calidad en tazas de mayor tamaño. La máquina ofrece los resultados óptimos en taza para cada mezcla mediante una preparación específica para cada cápsula con lectura de código de barras. Cada máquina incluye un set de bienvenida de cortesía con una variedad de cápsulas Nespresso Vertuo con perfiles de aroma únicos.","dept":"small_appliances","retailer":"bestbuy","weightKg":3.992,"weightPub":true}],"off-white & silver gt-2160 sneakers":[{"name":"Off-White & Silver GT-2160 Sneakers","brand":"ASICS","price":140,"image":"https://res.cloudinary.com/ssenseweb/image/upload/c_scale,f_auto,q_auto,w_1128/262092F128032_1.jpg","images":["98|","93|2.jpg","93|3.jpg","93|4.jpg","93|5.jpg"],"dept":"women","retailer":"ssense","src":[["/ssense-catalog.json",17476]]},{"name":"Off-White & Silver GT-2160 Sneakers","brand":"ASICS","price":140,"image":"https://res.cloudinary.com/ssenseweb/image/upload/c_scale,f_auto,q_auto,w_1128/262092F128032_1.jpg","images":["98|","93|2.jpg","93|3.jpg","93|4.jpg","93|5.jpg"],"retailer":"ssense","src":[["/ssense-catalog.json",32378]]}],"off-white loose flannel shirt":[{"name":"Off-White Loose Flannel Shirt","brand":"Dries Van Noten","price":875,"image":"https://res.cloudinary.com/ssenseweb/image/upload/c_scale,f_auto,q_auto,w_1128/262358M192040_1.jpg","images":["98|","93|2.jpg","93|3.jpg","93|4.jpg"],"dept":"men","retailer":"ssense","v":"1szoiva497ny4","g":"gx3yqc7142hgcd","c":"Off-White","src":[["/ssense-catalog.json",6062]]},{"name":"Off-White Loose Flannel Shirt","brand":"Dries Van Noten","price":875,"image":"https://res.cloudinary.com/ssenseweb/image/upload/c_scale,f_auto,q_auto,w_1128/262358M192040_1.jpg","images":["98|","93|2.jpg","93|3.jpg","93|4.jpg"],"retailer":"ssense","v":"1szoiva497ny4","g":"gx3yqc7142hgcd","c":"Off-White","src":[["/ssense-catalog.json",22269]]}],"opera wo