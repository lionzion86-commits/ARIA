e que parece sacada de la época dorada de la animación.","dept":"tech_gaming","retailer":"walmart","weightKg":0.55,"url":"https://www.walmart.com/ip/Cuphead-Nintendo-Switch/1358317801"}],"establishment split crewneck - marine":[{"name":"Establishment Split Crewneck - Marine","brand":"Alphalete","price":27.2,"wasPrice":68,"salePct":60,"image":"https://cdn.shopify.com/s/files/1/0667/0133/files/Establishment_Split_Crewneck_Marine_1.jpg?v=1762269856","images":["104|","86|5.jpg?v=1738958666","86|3.jpg?v=1738958666","86|4.jpg?v=1738958666","86|6.jpg?v=1738958658"],"description":"Buzo. Diseñado para entrenar con comodidad.","sizes":["XS","S","M","L","XL","XXL","XXXL"],"sizesTier":"scrape","sizesSource":"https://www.alphaleteathletics.com/products/mens-establishment-split-crewneck-marine","dept":"gym_rat","retailer":"alphalete","weightKg":0.61,"url":"https://www.alphaleteathletics.com/products/mens-establishment-split-crewneck-marine","v":"1cb47rtvteorr","g":"gmtbomr4khvc5","c":"Marine"}],"green 'the sera knit' tube top":[{"name":"Green 'The Sera knit' Tube Top","brand":"JACQUEMUS","price":500,"image":"https://res.cloudinary.com/ssenseweb/image/upload/c_scale,f_auto,q_auto,w_1128/262553F111000_1.jpg","images":["98|","93|2.jpg","93|3.jpg","93|4.jpg"],"sizes":["FR 36 = S","FR 38 = M","FR 40 = L"],"sizesTier":"scrape","sizesSource":"https://www.ssense.com/en-us/women/product/jacquemus/green-the-sera-knit-tube-top/19485011","dept":"women","retailer":"ssense","url":"https://www.ssense.com/en-us/women/product/jacquemus/green-the-sera-knit-tube-top/19485011","v":"qvvp1s74twjm","g":"g1rhi28ahpcoy","c":"Green","src":[["/ssense-catalog.json",12117]]},{"name":"Green 'The Sera knit' Tube Top","brand":"JACQUEMUS","price":500,"image":"https://res.cloudinary.com/ssenseweb/image/upload/c_scale,f_auto,q_auto,w_1128/262553F111000_1.jpg","images":["98|","93|2.jpg","93|3.jpg","93|4.jpg"],"sizes":["FR 36 = S","FR 38 = M","FR 40 = L"],"sizesTier":"scrape","sizesSource":"https://www.ssense.com/en