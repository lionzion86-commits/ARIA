{
  "_note": "Neiman Marcus via Sovrn Commerce: the keyword sweep plan for scripts/build-neimanmarcus-catalog.mjs --via sovrn. Sovrn has no bulk product feed; the Product Recommendation API returns at most 50 products per request, so the assortment is enumerated by many keyword requests filtered to Neiman Marcus (includeMerchants). Departments run in this order (sale and clearance first, so a sale copy of a product wins the de-duplication). Each department's terms run first, then, for departments with expand: true, every modifier x term. Extend freely: add terms, add departments (category, gender or bucket as in NM_QUOTAS), add modifiers. The `request` block is the request template; its field names beyond apiKey / includeMerchants / numProducts are ASSUMPTIONS (see scripts/lib/sovrn.js) -- verify them against Sovrn's API docs in the publisher dashboard before the first run. Placeholders: {apiKey} {groupId} {numProducts} {term}. The key is substituted at run time from SOVRN_API_KEY and never written to the raw files.",
  "request": {
    "method": "POST",
    "query": { "apiKey": "{apiKey}", "includeMerchants": "{groupId}", "numProducts": "{numProducts}" },
    "body": { "keywords": "{term}" }
  },
  "modifiers": ["black", "white", "blue", "red", "green", "pink", "brown", "beige", "gray", "gold", "silver", "leather", "suede", "cashmere", "silk", "cotton", "wool", "denim", "linen", "printed", "striped", "embellished", "designer"],
  "departments": [
    { "category": "sale", "phase": 1, "terms": ["sale", "on sale", "clearance", "markdown", "final sale", "women sale", "men sale", "shoes sale", "handbags sale", "jewelry sale", "beauty sale", "kids sale", "home sale", "designer sale", "last call"] },
    { "category": "clearance", "phase": 1, "terms": ["clearance dresses", "clearance shoes", "clearance handbags", "clearance sweaters", "clearance jackets", "clearance accessories", "reduced", "price drop", "extra off"] },
    { "category": "women_apparel", "phase": 2, "gender": "women", "expand": true, "terms": ["women dress", "cocktail dress", "evening gown", "midi dress", "maxi dress", "women blouse", "women shirt", "women top", "women t-shirt", "women sweater", "women cardigan", "women jacket", "women blazer", "women coat", "trench coat", "puffer jacket", "women pants", "women trousers", "women jeans", "women skirt", "women shorts", "jumpsuit", "women suit", "women activewear", "leggings", "sports bra", "women swimwear", "bikini", "one-piece swimsuit", "cover-up", "women sleepwear", "pajama set", "robe", "lingerie", "bra", "women hoodie", "women sweatshirt", "women knitwear", "women vest", "women poncho"] },
    { "category": "men_apparel", "phase": 2, "gender": "men", "expand": true, "terms": ["men shirt", "dress shirt", "men polo", "men t-shirt", "men sweater", "men cardigan", "men jacket", "men blazer", "sport coat", "men suit", "tuxedo", "men coat", "men puffer", "men pants", "men trousers", "men jeans", "men chinos", "men shorts", "men swim trunks", "men activewear", "men hoodie", "men sweatshirt", "men sleepwear", "men robe", "men underwear", "men socks", "men vest", "men knitwear", "men overshirt"] },
    { "category": "women_shoes", "phase": 2, "gender": "women", "expand": true, "terms": ["women pumps", "women heels", "women sandals", "women flats", "ballet flats", "women loafers", "women mules", "women slides", "women sneakers", "women boots", "ankle boots", "knee boots", "women espadrilles", "women wedges", "women slingback", "women platform shoes", "women slippers", "women clogs"] },
    { "category": "men_shoes", "phase": 2, "gender": "men", "expand": true, "terms": ["men sneakers", "men loafers", "men oxfords", "men derby shoes", "men boots", "chelsea boots", "men sandals", "men slides", "men drivers", "men slippers", "men dress shoes", "men espadrilles", "men monk strap"] },
    { "category": "handbags", "phase": 2, "bucket": "purses", "expand": true, "terms": ["handbag", "tote bag", "shoulder bag", "crossbody bag", "clutch", "evening bag", "top handle bag", "bucket bag", "hobo bag", "satchel", "belt bag", "backpack", "mini bag", "wallet", "card case", "wristlet", "pouch", "men bag", "briefcase", "duffle bag", "travel bag", "luggage"] },
    { "category": "accessories", "phase": 2, "expand": true, "terms": ["sunglasses", "eyewear", "belt", "scarf", "hat", "baseball cap", "beanie", "gloves", "hair accessories", "headband", "tie", "bow tie", "pocket square", "cufflinks", "keychain", "bag charm", "umbrella", "phone case", "tech accessories", "socks"] },
    { "category": "jewelry", "phase": 2, "bucket": "jewelry", "expand": true, "terms": ["necklace", "pendant necklace", "chain necklace", "earrings", "stud earrings", "hoop earrings", "drop earrings", "bracelet", "bangle", "cuff bracelet", "ring", "cocktail ring", "fine jewelry", "diamond", "pearl", "gold jewelry", "silver jewelry", "men jewelry", "watch", "women watch", "men watch", "brooch", "anklet"] },
    { "category": "beauty", "phase": 2, "bucket": "beauty", "terms": ["perfume", "eau de parfum", "eau de toilette", "cologne", "fragrance gift set", "candle fragrance", "lipstick", "lip gloss", "foundation", "concealer", "mascara", "eyeshadow", "blush", "bronzer", "highlighter", "makeup palette", "makeup brushes", "skincare", "serum", "moisturizer", "face cream", "eye cream", "cleanser", "toner", "face mask", "sunscreen", "body lotion", "body wash", "hair care", "shampoo", "conditioner", "hair oil", "hair tools", "nail polish", "men grooming", "beauty gift set"] },
    { "category": "kids", "phase": 2, "gender": "kids", "terms": ["girls dress", "girls top", "girls jacket", "girls shoes", "boys shirt", "boys pants", "boys jacket", "boys shoes", "baby clothing", "baby gift", "baby blanket", "kids sneakers", "kids swimwear", "kids pajamas", "kids accessories", "kids toys", "toddler clothing", "kids backpack"] },
    { "category": "home_small", "phase": 2, "bucket": "home_decor", "terms": ["candle", "home fragrance", "diffuser", "picture frame", "vase", "decorative object", "tabletop", "dinnerware", "glassware", "barware", "serveware", "tray", "throw blanket", "decorative pillow", "bath towels", "bedding", "coffee table book", "desk accessories", "pet accessories", "games"] }
  ]
}
